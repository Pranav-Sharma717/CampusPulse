# CampusPulse Configuration Template
PROJECT_NAME="CampusPulse"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# PostgreSQL with pgvector (default for Docker / production)
DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/campuspulse"

# JWT Authentication
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama LLM Configuration (Running locally on student laptop)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
